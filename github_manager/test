import requests


class BranchProtectionManager:
    """
    Manages the configuration of branch protection rules for a GitHub repository.
    """

    def __init__(self):
        pass

    def apply_branch_protection(self, base_url: str, headers: dict, branch_name: str, rules: dict):
        """
        Applies branch protection rules to the specified branch.

        :param base_url: The base API URL for the repository.
        :param headers: Authentication headers.
        :param branch_name: Name of the branch to protect (e.g., 'main').
        :param rules: Branch protection rules to apply.
        """
        url = f"{base_url}/branches/{branch_name}/protection"

        # Send the PUT request to apply branch protection rules
        response = requests.put(url, json=rules, headers=headers)

        # Handle the response
        if response.status_code == 200:
            print(f"Branch protection applied successfully to '{branch_name}'!")
        elif response.status_code == 403:
            raise Exception(f"Permission denied to protect branch '{branch_name}'. Check your token and permissions.")
        elif response.status_code == 404:
            raise Exception(f"Branch '{branch_name}' or repository not found.")
        else:
            raise Exception(f"Failed to protect branch '{branch_name}'. Error: {response.json()}")

    def get_default_protection_rules(self):
        """
        Returns a default set of branch protection rules.

        :return: Dictionary containing branch protection rules.
        """
        return {
            "required_status_checks": {
                "strict": True,
                "contexts": []  # Add specific status checks here if needed
            },
            "enforce_admins": True,  # Enforce protection rules for admins
            "required_pull_request_reviews": {
                "dismiss_stale_reviews": True,
                "require_code_owner_reviews": True,
                "required_approving_review_count": 1
            },
            "restrictions": None  # No restrictions on who can push
        }
